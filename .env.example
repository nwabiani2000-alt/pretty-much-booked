# Pretty Much Booked — environment
# Copy to .env.local on the VM and fill values for live mode.
# Do NOT use NEXT_PUBLIC_ for these — Cursor Secrets binding reserves that prefix.
# Values are read server-side and (where needed) exposed via /api/*/config.

# --- Admin gate ---
ADMIN_SECRET=
# Missing → demo secret `pmb-admin-demo` works on /admin/login (dev only).
# Required in production — demo secret is disabled when NODE_ENV=production.

# --- Signing (booking access tokens) ---
JWT_SECRET=
# Used to mint/verify booking access_token. Falls back to ADMIN_SECRET in dev.

# --- CORS (production) ---
CORS_ALLOWED_ORIGINS=https://prettymuchbooked.com,https://www.prettymuchbooked.com
# Comma-separated. Dev defaults to reflect any origin.

# --- Stripe deposits (London / card path) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Missing any → checkout mock Pay; /api/payments/config mode=mock
# Publishable key via GET /api/payments/config (never the secret).
# Live: PaymentIntent + Elements when secret + publishable set.

# --- Paystack escrow (Lagos path, scaffold) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Missing → mock Hold until complete; GET /api/paystack/config mode=mock
# Escrow release fires when tracking status → completed.

# --- FX (GBP → NGN display) ---
PMB_FX_GBP_NGN=2100
# Optional. Client can also override via Profile → FX (localStorage).
# Market toggle London/Lagos still works; only the NGN rate changes.

# --- Mapbox tracking ---
MAPBOX_ACCESS_TOKEN=
# Missing → placeholder map; GET /api/mapbox/config mode=mock
# Token served via GET /api/mapbox/config when set.

# --- Supabase Auth (phone OTP) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Missing → mock OTP (code 000000); GET /api/auth/config mode=mock

# --- Twilio SMS (Supabase phone provider) ---
# Configure in Supabase Dashboard → Auth → Providers → Phone → Twilio
# (not read by this app directly — Supabase sends SMS).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGE_SERVICE_SID=
# Or set the same values in Supabase project secrets for phone OTP.

# --- Public social URLs (marketing landing) ---
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
